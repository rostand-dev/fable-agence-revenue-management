# Base PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/nuitsignal?schema=public"
# Facultatif. Chaque propriétaire saisit sa propre clé Anthropic dans Intégrations et choisit un modèle par agent.
# ANTHROPIC_API_KEY sert de repli quand aucune clé n'est saisie ; ANTHROPIC_MODEL est le modèle par défaut. Sans aucune clé, repli déterministe.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Facultatif : adresse de l'API Anthropic (tests avec un faux serveur). Défaut : https://api.anthropic.com
# ANTHROPIC_API_BASE=""
# URL publique (cookies sécurisés si https)
APP_URL="http://localhost:3000"
# Chiffre les clés API enregistrées (PriceLabs par logement, Anthropic par propriétaire). Longue valeur aléatoire ; la changer rend les clés déjà enregistrées illisibles.
APP_SECRET=""
# Facultatif : minutes d'inactivité avant déconnexion automatique (défaut 15, minimum 2). Lu au démarrage du serveur.
SESSION_IDLE_MINUTES="15"
# Mot de passe oublié : envoi des e-mails via Resend (resend.com). Sans clé, aucun e-mail n'est envoyé.
RESEND_API_KEY=""
# Expéditeur, sur un domaine vérifié dans Resend (SPF/DKIM). Ex. : NuitSignal <no-reply@votre-domaine.fr>
EMAIL_FROM=""
# Facultatif : adresse de réponse
EMAIL_REPLY_TO=""
# Facultatif : durée de validité du lien de réinitialisation, en minutes (défaut 30, entre 5 et 120)
PASSWORD_RESET_MINUTES="30"

# Inscription : confirmation de l'adresse par e-mail avant création du compte (true par défaut, nécessite Resend).
# Mettre "false" dans un environnement de preview pour créer le compte immédiatement, sans e-mail.
SIGNUP_EMAIL_CONFIRMATION="true"

# Compte de démo des environnements de test/preview : créé au démarrage (idempotent), avec les logements de démonstration.
# NE PAS DÉFINIR en production. Il faut trois conditions : DEMO_ACCOUNT_ENABLED=true, un domaine de APP_URL qui correspond à
# DEMO_ACCOUNT_ALLOWED_HOST (joker de tête accepté, ex. *.nuit-signal.rosyops.io, qui ne couvre pas le domaine nu), et un mot de passe d'au moins 10 caractères.
DEMO_ACCOUNT_ENABLED="false"
DEMO_ACCOUNT_ALLOWED_HOST=""
DEMO_ACCOUNT_EMAIL=""
DEMO_ACCOUNT_PASSWORD=""
# Facultatif (défaut : Compte démo)
# DEMO_ACCOUNT_NAME=""

# Démo publique en lecture seule (voir README « Démo publique »). À définir uniquement sur l'application Coolify de la démo.
# DEMO_READONLY=true refuse toute modification et ouvre /demo (session du compte de démo, sans mot de passe) ;
# il exige aussi DEMO_ACCOUNT_ENABLED=true et un DEMO_ACCOUNT_ALLOWED_HOST qui correspond au domaine de la démo.
DEMO_READONLY="false"
# Sur la démo : adresse de création de compte de la production (bandeau et bouton « Quitter la démo »)
DEMO_SIGNUP_URL=""
# Sur la production : adresse de la démo (affiche « Voir la démo, sans compte » sur les pages de connexion)
DEMO_URL=""

