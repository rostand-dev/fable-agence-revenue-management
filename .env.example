# Base PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/nuitsignal?schema=public"
# Facultatif : active le raisonnement LLM des agents. Sans clé, repli déterministe.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# URL publique (cookies sécurisés si https)
APP_URL="http://localhost:3000"
# Chiffre les clés API enregistrées par logement (PriceLabs). Longue valeur aléatoire ; la changer rend les clés déjà enregistrées illisibles.
APP_SECRET=""
