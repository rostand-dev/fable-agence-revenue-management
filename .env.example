# Chaque variable est décrite juste au-dessus. Les lignes commentées (#) sont facultatives.

# --- Base de données ---
# Chaîne de connexion PostgreSQL (utilisateur, mot de passe, hôte, port, base). Obligatoire.
DATABASE_URL="postgresql://user:password@localhost:5432/nuitsignal?schema=public"

# --- Application ---
# Isolation entre propriétaires par la base (Row Level Security, US-011). "off" par défaut : seuls les filtres de l'application protègent.
# "on" : les lectures sensibles (journal d'audit) s'exécutent sous le rôle restreint nuitsignal_app, créé par la migration 0011, et /api/health passe en erreur
# si ce rôle manque (privilège CREATEROLE requis pour la migration). Vérifier d'abord que /api/health affiche "tenantIsolation":"available", puis passer à "on". Facultatif.
TENANT_RLS="off"

# Durée minimale d'observation (mode « Observation ») avant qu'un logement puisse être activé, en jours (US-024, blueprint §6.1).
# 14 par défaut, de 0 à 90. Une valeur vide, non entière ou hors plage revient à 14. Facultatif.
# 0 supprime ce délai : un logement peut être activé le jour même de son lancement (floors validés et rapprochement de réservations restent exigés).
# À réserver aux environnements de test ou de préproduction ; en production, laisser 14. Redéployer après modification.
ACTIVATION_SHADOW_MIN_DAYS="14"
# Adresse publique de l'application, avec https en ligne. Sert aux liens des e-mails ; les cookies deviennent « sécurisés » si elle commence par https.
APP_URL="http://localhost:3000"
# Clé qui chiffre les clés API enregistrées (PriceLabs et SuperHote par logement, Anthropic par propriétaire). Longue valeur aléatoire ; la changer rend illisibles les clés déjà enregistrées. Obligatoire.
APP_SECRET=""
# Minutes d'inactivité avant déconnexion automatique (défaut 15, minimum 2). Lue au démarrage du serveur. Facultatif.
SESSION_IDLE_MINUTES="15"
# Jours pendant lesquels un appareil reste reconnu quand la case « Rester connecté sur cet appareil » est cochée à la connexion (défaut 30, entier de 1 à 90 ; 0 = fonction désactivée, la case disparaît). Facultatif.
# Au-delà de SESSION_IDLE_MINUTES d'inactivité, la session est rétablie sans mot de passe, mais le mot de passe est redemandé pour modifier une clé API.
REMEMBER_ME_DAYS="30"

# --- Données personnelles (US-034) ---
# Masquage des données personnelles (e-mails, téléphones, IBAN, cartes, secrets) dans les journaux du serveur. "on" par défaut ; "off" désactive ce masquage,
# pour un débogage local seulement (jamais en production ni en staging). Lue au démarrage : redéployer après modification. Les envois aux modèles de langage et le journal d'audit restent masqués dans tous les cas. Facultatif.
LOG_PII_MASKING="on"

# --- Agents IA (Anthropic) ---
# Clé Anthropic de repli, utilisée quand le propriétaire n'a saisi aucune clé dans Intégrations. Vide = repli déterministe, sans modèle de langage. Facultatif.
ANTHROPIC_API_KEY=""
# Modèle Anthropic par défaut des agents (chaque propriétaire peut en choisir un par agent). Facultatif.
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Adresse de l'API Anthropic, pour les tests avec un faux serveur. Défaut : https://api.anthropic.com. Facultatif.
# ANTHROPIC_API_BASE=""
# Repli OpenAI du serveur (US-070) : utilisé par les agents seulement si Anthropic est en panne ou renvoie une sortie inexploitable. Jamais la clé d'un propriétaire.
# Actif uniquement si OPENAI_API_KEY ET OPENAI_MODEL sont renseignés (aucun nom de modèle n'est deviné). Vides = pas de repli. Facultatif.
OPENAI_API_KEY=""
# Modèle OpenAI du repli (identifiant exact du modèle, ex. celui de votre compte OpenAI). Obligatoire avec OPENAI_API_KEY pour activer le repli.
OPENAI_MODEL=""
# Adresse de l'API OpenAI, pour les tests avec un faux serveur. Défaut : https://api.openai.com. Facultatif.
# OPENAI_API_BASE=""

# Budget des agents (US-074). Plafond d'appels HTTP aux fournisseurs de modèle par revue (une correction ou un repli compte pour un appel) : au-delà, les agents passent en repli déterministe pour le reste de la revue. Entier de 0 à 100000000 ; 0 désactive les appels ; invalide = défaut. Défaut 80. Facultatif.
AGENT_MAX_CALLS_PER_REVIEW="80"
# Budget de jetons (entrée + sortie) par propriétaire et par jour UTC : une fois atteint, repli déterministe jusqu'au lendemain. Mêmes règles de valeur. Défaut 300000. Facultatif.
AGENT_DAILY_TOKEN_BUDGET="300000"

# --- Intégrations (tests uniquement) ---
# Adresse de l'API PriceLabs, pour les tests avec un faux serveur. Défaut : https://api.pricelabs.co/v1. Facultatif.
# ATTENTION : la clé API de chaque propriétaire est envoyée à cette adresse. Ne jamais la définir en production ni sur le staging ; elle ne sert qu'aux tests
# de bout en bout et à la CI (faux serveur local : http://127.0.0.1:4010/v1, voir FAKE_PRICELABS_PORT). Lue à chaque appel à PriceLabs.
# PRICELABS_API_BASE=""
# Port du faux serveur PriceLabs lancé par `npm run fake:pricelabs` (et par Playwright quand PRICELABS_API_BASE pointe vers cette machine). Défaut : 4010. Tests uniquement. Facultatif.
# FAKE_PRICELABS_PORT=""

# Port du faux serveur de modèle (scripts/fake-llm-server.ts), utilisé par les tests de bout en bout et la CI : il imite Anthropic et OpenAI sans réseau ni coût.
# Défaut : 4011. Le serveur n'est lancé que si ANTHROPIC_API_BASE pointe vers cette machine (127.0.0.1 ou localhost). Jamais à renseigner en production.
# FAKE_LLM_PORT=""
# Adresse de l'API SuperHote, pour les tests avec un faux serveur. Défaut : https://connect.superhote.com/api/v2/public. Facultatif.
# SUPERHOTE_API_BASE=""
# Adresse publique (https, joignable depuis Internet) où SuperHote envoie ses webhooks de réservation : l'URL enregistrée est cette adresse + /api/webhooks/superhote/<identifiant>.
# Vide = APP_URL. À renseigner seulement si l'application est exposée sous une autre adresse que APP_URL. Une adresse locale, privée ou en http est refusée (SuperHote ne peut pas l'atteindre) : les webhooks ne s'activent alors pas. Lue à l'activation. Facultatif.
# SUPERHOTE_WEBHOOK_BASE_URL=""

# --- E-mails (Resend) ---
# Clé API Resend (resend.com) pour envoyer les e-mails : mot de passe oublié et confirmation d'inscription. Vide = aucun e-mail n'est envoyé.
RESEND_API_KEY=""
# Expéditeur, sur un domaine vérifié dans Resend (SPF et DKIM). Ex. : NuitSignal <no-reply@votre-domaine.fr>
EMAIL_FROM=""
# Adresse de réponse des e-mails envoyés. Facultatif.
EMAIL_REPLY_TO=""
# Durée de validité du lien de réinitialisation du mot de passe, en minutes (défaut 30, entre 5 et 120). Facultatif.
PASSWORD_RESET_MINUTES="30"

# --- Inscription ---
# Confirmation de l'adresse par e-mail avant la création du compte (true par défaut ; nécessite Resend).
# Mettre "false" en preview pour créer le compte immédiatement, sans e-mail (les adresses déjà inscrites deviennent alors repérables).
SIGNUP_EMAIL_CONFIRMATION="true"

# --- Compte de démo des environnements de test/preview (NE PAS DÉFINIR en production) ---
# Le compte est créé au démarrage, avec les logements de démonstration, si les trois conditions sont réunies :
# DEMO_ACCOUNT_ENABLED=true, un domaine de APP_URL qui correspond à DEMO_ACCOUNT_ALLOWED_HOST, et un mot de passe d'au moins 10 caractères.
# Interrupteur : true crée le compte de démo au démarrage ; tout le reste le désactive (défaut false).
DEMO_ACCOUNT_ENABLED="false"
# Domaine autorisé : celui de APP_URL doit y correspondre. Motif exact (demo.exemple.fr) ou joker de tête (*.nuit-signal.rosyops.io), qui exige un sous-domaine et ne couvre donc pas le domaine nu de la production.
DEMO_ACCOUNT_ALLOWED_HOST=""
# Adresse e-mail de connexion du compte de démo.
DEMO_ACCOUNT_EMAIL=""
# Mot de passe du compte de démo, 10 caractères au moins. Non modifié si le compte existe déjà.
DEMO_ACCOUNT_PASSWORD=""
# Nom affiché du compte de démo (défaut : Compte démo). Facultatif.
# DEMO_ACCOUNT_NAME=""

# --- Démo publique en lecture seule (voir README « Démo publique ») ---
# Réservé à l'application Coolify de la démo. true refuse toute modification et ouvre /demo (session du compte de démo, sans mot de passe) ;
# exige aussi DEMO_ACCOUNT_ENABLED=true et un DEMO_ACCOUNT_ALLOWED_HOST qui correspond au domaine de la démo. Défaut false. Ne jamais définir en production ni en preview.
DEMO_READONLY="false"
# Sur la démo : adresse de création de compte sur la production (bandeau « Créer mon compte » et bouton « Quitter la démo »).
DEMO_SIGNUP_URL=""
# Sur la production : adresse de la démo. Affiche « Voir la démo, sans compte » sous le formulaire de connexion ; vide = pas de bouton.
DEMO_URL=""

# --- Protection des previews (Coolify, variables « Preview Deployment » uniquement ; jamais en production, sur la démo ni sur le staging) ---
# Identifiant exigé (HTTP Basic) pour ouvrir une preview. Vide ou absent = pas de protection. Ne doit pas contenir « : ».
# PREVIEW_BASIC_AUTH_USER=""
# Mot de passe associé, 12 caractères au moins. Un identifiant sans mot de passe (ou l'inverse, ou un mot de passe trop court) refuse tout accès (503) plutôt que de laisser la preview ouverte. /api/health reste accessible.
# PREVIEW_BASIC_AUTH_PASSWORD=""
# Commit Git déployé, publié par /api/health (compose : repris de SOURCE_COMMIT, fourni par Coolify). Facultatif.
# APP_COMMIT=""

# --- Tests de bout en bout (Playwright, `npm run e2e`) : poste de développement et CI uniquement, jamais en production ---
# Adresse de l'application à tester (ex. une Preview Coolify). Absente : Playwright lance l'application locale (`npm run start`, après `npm run build`).
# E2E_BASE_URL=""
# Adresse e-mail du compte de démo avec lequel Playwright se connecte (celle de DEMO_ACCOUNT_EMAIL de l'environnement testé). Obligatoire pour `npm run e2e`.
# E2E_EMAIL=""
# Mot de passe de ce compte de démo (celui de DEMO_ACCOUNT_PASSWORD de l'environnement testé). Obligatoire pour `npm run e2e`.
# E2E_PASSWORD=""
# Identifiants HTTP Basic de la preview testée (ceux de PREVIEW_BASIC_AUTH_USER / PREVIEW_BASIC_AUTH_PASSWORD). Absents = environnement non protégé. Facultatif.
# E2E_HTTP_USER=""
# E2E_HTTP_PASSWORD=""
# Chemin d'un Chrome déjà installé, si le téléchargement du navigateur de Playwright est impossible (poste local). Facultatif.
# E2E_CHROME_PATH=""

# --- Exécution PriceLabs (épic 9) ---
# Verrou d'environnement de l'ÉCRITURE chez PriceLabs : NuitSignal ne modifie les prix d'un logement RÉEL (prix minimum, prix de base, prix datés à prix fixe) que si cette variable vaut exactement « true ».
# Absente, vide ou autre valeur = écriture fermée : les actions restent à exécuter à la main, et la page Intégrations affiche « Désactivée sur cet environnement ». Les logements de démonstration restent simulés quoi qu'il arrive.
# À laisser fermée tant que la procédure de première écriture n'est pas validée (voir docs/epic-9-execution-pricelabs.md). Le coupe-circuit de l'application s'applique en plus. Facultatif, défaut : fermée.
# Ne pas la déclarer avec une valeur vide sur Coolify (Coolify refuse les valeurs vides) : ne pas la créer, ou la renseigner avec « true » / « false ».
# PRICELABS_WRITE_ENABLED="false"
