{
  "name": "nuitsignal-agence-rm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:idempotent": "tsx scripts/idempotent-migrations.ts",
    "docs:money": "tsx scripts/generate-money-doc.ts",
    "docs:capabilities": "tsx scripts/generate-capabilities-doc.ts",
    "docs:stacking": "tsx scripts/generate-stacking-doc.ts",
    "test:golden": "vitest run src/lib/engine/review-golden.test.ts src/lib/agents/agents-golden.test.ts src/lib/agents/no-external-write.test.ts",
    "test:db": "vitest run -c vitest.db.config.mts",
    "test:all": "npm test && npm run test:db",
    "e2e": "playwright test",
    "e2e:landing": "playwright test -c landing/playwright.config.ts",
    "fixtures:pricelabs": "tsx scripts/pricelabs-fixture.ts",
    "fake:pricelabs": "tsx scripts/fake-pricelabs-server.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
